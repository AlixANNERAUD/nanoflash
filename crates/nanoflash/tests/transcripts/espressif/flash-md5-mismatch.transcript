# Flashes esp32-s3-usb as flash-esp32s3-usb does, but the board answers the MD5 check of
# the application with 32 zero digits, so verification fails; the board is still reset into
# the application.
! identity 303a:1001
! signals dtr=0 rts=0
! sleep 100
! signals dtr=1 rts=0
! sleep 100
! signals dtr=1 rts=1
! signals dtr=0 rts=1
! sleep 100
