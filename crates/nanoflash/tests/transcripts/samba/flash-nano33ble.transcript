# flash of the arduino-nano-33-ble fixture board: connect-nano33ble, then write-nano33ble
# Arduino Nano 33 BLE running a sketch: 1200-baud touch, then the bootloader on 2341:005a
! identity 2341:805a
! baud 1200
! signals dtr=0 rts=0
! reopen 2341:005a
> "N#"
< "\n\r"
> "V#"
< "Arduino Bootloader (SAM-BA extended) 2.0 [Arduino:IKXYZ]\n\r"
> "I#"
< "nRF52840-QIAA\n\r"
# application.bin (8192 bytes) written at 0x10000 of a Nano 33 BLE, checked, then K: addresses
# count from the application start, and X erases nothing on the nRF52840
> "X00000000#"
< "X\n\r"
> "S00000034,00001000#" ..4096
! sleep 10
> "Y00000034,0#"
< "Y\n\r"
> "Y00000000,00001000#"
< "Y\n\r"
> "S00000034,00001000#" ..4096
! sleep 10
> "Y00000034,0#"
< "Y\n\r"
> "Y00001000,00001000#"
< "Y\n\r"
> "Z00000000,00001000#"
< "Z0000D5B0#\n\r"
> "Z00001000,00001000#"
< "Z0000D5B0#\n\r"
> "K#"
