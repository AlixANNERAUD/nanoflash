# write-nano33ble whose second half does not read back: the board computes 0x1234
> "X00000000#"
< "X\n\r"
> "S00000034,00001000#" ..4096
! sleep 10
> "Y00000034,0#"
< "Y\n\r"
> "Y00000000,00001000#"
< "Y\n\r"
> "S00000034,00001000#" ..4096
! sleep 10
> "Y00000034,0#"
< "Y\n\r"
> "Y00001000,00001000#"
< "Y\n\r"
> "Z00000000,00001000#"
< "Z0000D5B0#\n\r"
> "Z00001000,00001000#"
< "Z00001234#\n\r"
> "K#"
