# flash of the arduino-nano-33-ble fixture board whose second half does not read back: connect-nano33ble, then crc-mismatch
# Arduino Nano 33 BLE running a sketch: 1200-baud touch, then the bootloader on 2341:005a
! identity 2341:805a
! baud 1200
! signals dtr=0 rts=0
! reopen 2341:005a
> "N#"
< "\n\r"
> "V#"
< "Arduino Bootloader (SAM-BA extended) 2.0 [Arduino:IKXYZ]\n\r"
> "I#"
< "nRF52840-QIAA\n\r"
# write-nano33ble whose second half does not read back: the board computes 0x1234
> "X00000000#"
< "X\n\r"
> "S00000034,00001000#" ..4096
! sleep 10
> "Y00000034,0#"
< "Y\n\r"
> "Y00000000,00001000#"
< "Y\n\r"
> "S00000034,00001000#" ..4096
! sleep 10
> "Y00000034,0#"
< "Y\n\r"
> "Y00001000,00001000#"
< "Y\n\r"
> "Z00000000,00001000#"
< "Z0000D5B0#\n\r"
> "Z00001000,00001000#"
< "Z00001234#\n\r"
> "K#"
